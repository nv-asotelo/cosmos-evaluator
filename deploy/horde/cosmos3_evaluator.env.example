# Cosmos Evaluator + Cosmos3 Super Reasoner NIM deployment settings.
# Copy to ~/.cosmos_evaluator/evaluator.env on the Horde host and fill only
# values needed by your storage mode. Keep credential-bearing files chmod 0600.

COSMOS_EVALUATOR_ENV=local
COSMOS_EVALUATOR_STORAGE_TYPE=local
COSMOS_EVALUATOR_STORAGE_BUCKET=
COSMOS_EVALUATOR_STORAGE_REGION=
COSMOS_EVALUATOR_STORAGE_ACCESS_KEY=
COSMOS_EVALUATOR_STORAGE_SECRET_KEY=

# Used by attribute verification question generation. Local Cosmos3 NIM is used
# for VLM verification, but the question generator still calls a text LLM.
BUILD_NVIDIA_API_KEY=

# Multistorage JSON for hallucination and attribute verification. Leave empty
# when only health checks and VLM preset local-storage requests are needed.
MULTISTORAGECLIENT_CONFIGURATION=

# Local OpenAI-compatible NIMs do not require an inference API key, but the
# OpenAI client needs a non-empty placeholder.
COSMOS3_NIM_API_KEY=not-used
